# Copy this file to keystore.properties (gitignored) and fill in your own values.
# Then generate a keystore, for example:
#   keytool -genkeypair -v -keystore app/release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias deepsage
storeFile=app/release.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
